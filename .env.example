# =========================================================================
# SPOTon Chat - Environment Variables (For Vercel / Cloud Deployment)
# Supabase Edition
# =========================================================================

# 1. Supabase Project URL
# Found in Supabase Dashboard > Project Settings > API > Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Public Anon Key
# Found in Supabase Dashboard > Project Settings > API > Project API Keys > anon (public)
# NOTE: This key is SAFE for frontend exposure because access is secured by Row Level Security (RLS).
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# 3. Supabase Storage Bucket Name for profile pictures
SUPABASE_STORAGE_BUCKET=avatars

# =========================================================================
# SENSITIVE / SERVER-SIDE ONLY VARIABLES
# =========================================================================
# CRITICAL SECURITY RULE:
# NEVER expose the service_role key to frontend JavaScript!
# Only use this key if you deploy serverless edge functions that require admin rights.
# SUPABASE_SERVICE_ROLE_KEY=your_secret_service_role_key_here
